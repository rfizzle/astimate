{{define "style"}}
/* Layout: a guided read. One big verdict, a "start here" path of three, a playful bubble map, then a browsable table and a glossary. Stickers, chunky meters, rounded everything. */
:root {
  --bg: #f4f1fb; --panel: #ffffff; --ink: #1b1535; --muted: #5f5a78; --line: #e2dcf3; --soft: #ece7fa;
  --accent: #5b2bff; --accent-ink: #ffffff; --accent-soft: #e9e2ff;
  --split: #ff4f5e; --split-soft: #ffe3e6; --watch: #f59e0b; --watch-soft: #fff0cf; --fine: #16c79a; --fine-soft: #d9f8ee;
  --term: #1b1535; --term-ink: #f1edff;
  --glow: 0 18px 50px -24px rgba(27,21,53,.35);
  --display: "Bricolage Grotesque", "Avenir Next", "Segoe UI", sans-serif; --sans: "DM Sans", "Segoe UI", system-ui, sans-serif; --mono: "JetBrains Mono", ui-monospace, Menlo, Consolas, monospace;
}
@media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) {
  --bg: #120e21; --panel: #1b1630; --ink: #f1edff; --muted: #a9a3c6; --line: #2d2649; --soft: #221c3d;
  --accent: #9d7bff; --accent-ink: #120e21; --accent-soft: #2b2152;
  --split: #ff6b78; --split-soft: #3c1f2a; --watch: #ffb63d; --watch-soft: #3d2c12; --fine: #35e3b0; --fine-soft: #143a31;
  --term: #0c0917; --term-ink: #f1edff;
  --glow: 0 18px 50px -24px rgba(0,0,0,.8); color-scheme: dark } }
:root[data-theme="dark"] {
  --bg: #120e21; --panel: #1b1630; --ink: #f1edff; --muted: #a9a3c6; --line: #2d2649; --soft: #221c3d;
  --accent: #9d7bff; --accent-ink: #120e21; --accent-soft: #2b2152;
  --split: #ff6b78; --split-soft: #3c1f2a; --watch: #ffb63d; --watch-soft: #3d2c12; --fine: #35e3b0; --fine-soft: #143a31;
  --term: #0c0917; --term-ink: #f1edff;
  --glow: 0 18px 50px -24px rgba(0,0,0,.8); color-scheme: dark }
* { box-sizing: border-box }
body { background: var(--bg); color: var(--ink); font-family: var(--sans); font-size: 16px; line-height: 1.55; margin: 0; padding-block: 0 72px; padding-inline: 16px;
  background-image: radial-gradient(1200px 500px at 10% -10%, var(--accent-soft), transparent 60%), radial-gradient(700px 400px at 100% 0%, var(--fine-soft), transparent 55%) }
.wrap { max-width: 1100px; margin: 0 auto }
h1, h2, h3 { font-family: var(--display); text-wrap: balance; margin: 0; line-height: 1.08; letter-spacing: -.01em }
h1 { font-size: clamp(30px, 5vw, 50px); font-weight: 800 }
h2 { font-size: clamp(24px, 3.4vw, 32px); font-weight: 800; margin-top: 56px }
h3 { font-size: 20px; font-weight: 700 }
p { margin: 0 } .muted { color: var(--muted) } .mono { font-family: var(--mono); font-size: 13px } .num { font-variant-numeric: tabular-nums }
a { color: var(--accent) }
.eyebrow { font-family: var(--mono); font-size: 12px; letter-spacing: .12em; text-transform: uppercase; color: var(--muted) }
header { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px; padding-block: 22px 8px }
.logo { font-family: var(--display); font-weight: 800; font-size: 20px; letter-spacing: -.02em; display: inline-flex; align-items: center; gap: 8px }
.logo i { width: 14px; height: 14px; border-radius: 4px; background: linear-gradient(135deg, var(--accent), var(--fine)); transform: rotate(12deg); display: inline-block }
nav { display: inline-flex; gap: 4px; background: var(--soft); padding: 4px; border-radius: 999px }
nav button { background: none; border: 0; border-radius: 999px; padding: 8px 16px; font: inherit; font-weight: 600; font-size: 14px; color: var(--muted); cursor: pointer }
nav button[aria-selected="true"] { background: var(--panel); color: var(--ink); box-shadow: 0 2px 10px -4px rgba(0,0,0,.25) }
button:focus-visible, th:focus-visible, input:focus-visible, summary:focus-visible, tr:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px }
section[hidden], svg[hidden] { display: none }

/* hero */
.hero { display: grid; grid-template-columns: 1fr auto; gap: 24px 40px; align-items: center; margin-top: 28px; background: var(--panel); border-radius: 28px; padding: 34px 36px; box-shadow: var(--glow); position: relative; overflow: hidden }
.hero::after { content: ""; position: absolute; right: -80px; top: -80px; width: 260px; height: 260px; border-radius: 50%; background: radial-gradient(circle at 30% 30%, var(--accent-soft), transparent 70%); pointer-events: none }
@media (max-width: 760px) { .hero { grid-template-columns: 1fr; padding: 26px 22px } }
.hero .lead { font-size: 18px; margin-top: 14px; max-width: 58ch; color: var(--muted) }
.stickers { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 20px }
.sticker { font-family: var(--display); font-weight: 700; font-size: 14px; padding: 8px 14px; border-radius: 12px; display: inline-flex; gap: 8px; align-items: baseline; transform: rotate(-1.2deg); box-shadow: 0 6px 16px -10px rgba(0,0,0,.35) }
.sticker:nth-child(2n) { transform: rotate(1deg) } .sticker b { font-size: 20px; font-weight: 800 }
.sticker.split { background: var(--split-soft); color: var(--split) } .sticker.watch { background: var(--watch-soft); color: var(--watch) } .sticker.fine { background: var(--fine-soft); color: var(--fine) } .sticker.ink { background: var(--soft); color: var(--ink) }
.ring { width: 190px; height: 190px; position: relative; justify-self: center; z-index: 1 }
.ring svg { width: 100%; height: 100%; transform: rotate(-90deg) }
.ring .c { position: absolute; inset: 0; display: grid; place-content: center; text-align: center }
.ring .c b { font-family: var(--display); font-size: 40px; font-weight: 800; line-height: 1 } .ring .c span { font-size: 13px; color: var(--muted) }

/* start here */
.steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 18px } @media (max-width: 860px) { .steps { grid-template-columns: 1fr } }
.step { background: var(--panel); border-radius: 22px; padding: 22px; box-shadow: var(--glow); display: grid; gap: 10px; align-content: start; border-top: 6px solid var(--line); min-width: 0; position: relative }
.step.split { border-top-color: var(--split) } .step.watch { border-top-color: var(--watch) } .step.fine { border-top-color: var(--fine) }
.step .n { font-family: var(--display); font-weight: 800; font-size: 44px; line-height: 1; color: var(--accent); letter-spacing: -.04em }
.step .name { font-family: var(--mono); font-size: 14px; font-weight: 600; word-break: break-all }
.step .say { font-size: 15px } .step .say b { font-weight: 600 }
.step .do { font-size: 15px; padding: 10px 12px; border-radius: 12px; background: var(--soft) }
.step .do::before { content: "Do this → "; font-weight: 700; color: var(--accent) }
.facts { display: flex; flex-wrap: wrap; gap: 8px } .fact { font-size: 13px; padding: 4px 10px; border-radius: 999px; background: var(--soft); color: var(--muted) } .fact b { color: var(--ink) }
.meter { height: 12px; border-radius: 999px; background: var(--soft); overflow: hidden; position: relative }
.meter span { position: absolute; inset: 0 auto 0 0; border-radius: 999px; background: linear-gradient(90deg, var(--accent), var(--split)) }
.meter.fine span { background: var(--fine) } .meter.watch span { background: var(--watch) } .meter.split span { background: var(--split) }
.meter span.allow { background: var(--fine); opacity: .9 }
@media (prefers-reduced-motion: no-preference) { .meter span { transition: width .6s cubic-bezier(.2,.8,.2,1) } }

/* map */
.mapcard { background: var(--panel); border-radius: 26px; padding: 22px; box-shadow: var(--glow); margin-top: 18px }
.maphead { display: flex; flex-wrap: wrap; gap: 10px 18px; align-items: center; justify-content: space-between; margin-bottom: 8px }
.seg { display: inline-flex; background: var(--soft); border-radius: 999px; padding: 3px } .seg button { border: 0; background: none; font: inherit; font-size: 13px; font-weight: 600; padding: 6px 12px; border-radius: 999px; color: var(--muted); cursor: pointer } .seg button[aria-pressed="true"] { background: var(--panel); color: var(--ink) }
.legend { display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: 13px; color: var(--muted) } .legend i { display: inline-block; width: 12px; height: 12px; border-radius: 50%; margin-right: 6px; vertical-align: -1px }
.b-split { background: var(--split) } .b-watch { background: var(--watch) } .b-fine { background: var(--fine) }
svg text { font-family: var(--sans); fill: var(--ink) } .tick { font-size: 11px; fill: var(--muted) } .axis { stroke: var(--line) }
.bub circle { stroke: var(--panel); stroke-width: 2; cursor: pointer } .bub .split { fill: var(--split) } .bub .watch { fill: var(--watch) } .bub .fine { fill: var(--fine) }
.bub text { font-family: var(--display); font-weight: 700; pointer-events: none; fill: #fff; text-anchor: middle }
.bub .sub { font-family: var(--mono); font-weight: 400; font-size: 9px; opacity: .9 }
.sc circle { stroke: var(--panel); stroke-width: 1.5; opacity: .85; cursor: pointer } .sc .split { fill: var(--split) } .sc .watch { fill: var(--watch) } .sc .fine { fill: var(--fine) }
.sc .lbl { font-family: var(--mono); font-size: 11px } .sc .zone { font-family: var(--display); font-weight: 700; font-size: 13px; fill: var(--muted); opacity: .7 }
.tip { position: fixed; pointer-events: none; background: var(--ink); color: var(--bg); padding: 8px 12px; border-radius: 10px; font-size: 13px; max-width: 280px; z-index: 5; box-shadow: var(--glow) }
.tip b { font-family: var(--mono); font-size: 12px }

/* browse */
.toolbar { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin-top: 16px }
.chips { display: inline-flex; flex-wrap: wrap; gap: 6px } .chip { border: 2px solid var(--line); background: var(--panel); border-radius: 999px; padding: 6px 12px; font: inherit; font-size: 13px; font-weight: 600; color: var(--muted); cursor: pointer } .chip[aria-pressed="true"] { border-color: var(--accent); color: var(--accent) }
.chip.split[aria-pressed="true"] { border-color: var(--split); color: var(--split) } .chip.watch[aria-pressed="true"] { border-color: var(--watch); color: var(--watch) } .chip.fine[aria-pressed="true"] { border-color: var(--fine); color: var(--fine) }
input[type=search] { font: inherit; font-size: 14px; padding: 8px 14px; border-radius: 999px; border: 2px solid var(--line); background: var(--panel); color: var(--ink); min-width: 200px; flex: 1 }
.tablewrap { overflow-x: auto; background: var(--panel); border-radius: 22px; box-shadow: var(--glow); margin-top: 14px }
table { border-collapse: collapse; width: 100%; font-size: 14px }
th, td { padding: 10px 12px; text-align: left; white-space: nowrap; border-bottom: 1px solid var(--line) }
th { font-size: 12px; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); cursor: pointer; user-select: none; position: sticky; top: 0; background: var(--panel) }
th[aria-sort="descending"]::after { content: " ↓"; color: var(--accent) } th[aria-sort="ascending"]::after { content: " ↑"; color: var(--accent) }
tr.row { cursor: pointer } tr.row:hover td { background: var(--soft) }
td.path { font-family: var(--mono); font-size: 13px; max-width: 340px; overflow: hidden; text-overflow: ellipsis }
.dot { display: inline-block; width: 10px; height: 10px; border-radius: 50%; margin-right: 8px; vertical-align: 0 }
td .mini { display: inline-block; width: 90px; height: 8px; border-radius: 999px; background: var(--soft); vertical-align: middle; overflow: hidden; margin-right: 8px } td .mini span { display: block; height: 100%; background: var(--accent) } td .mini span.over { background: var(--split) }
td .over { color: var(--split); font-weight: 600 }
tr.detail td { background: var(--soft); white-space: normal; padding: 18px 20px }
.detail .say { font-size: 15px; max-width: 70ch } .detail .say b { font-weight: 600 }
.detail .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 12px 24px; margin-top: 14px }
.detail .row2 { display: grid; grid-template-columns: 1fr; gap: 4px; font-size: 13px } .detail .row2 .l { display: flex; justify-content: space-between; color: var(--muted) } .detail .row2 .l b { color: var(--ink); font-weight: 600 }
.detail .kv { font-size: 14px } .detail .kv span { display: block; font-size: 12px; letter-spacing: .06em; text-transform: uppercase; color: var(--muted) }

/* change */
.ribbon { margin-top: 28px; border-radius: 28px; padding: 30px 34px; background: var(--panel); box-shadow: var(--glow); display: grid; grid-template-columns: auto 1fr; gap: 20px 28px; align-items: center } @media (max-width: 760px) { .ribbon { grid-template-columns: 1fr; padding: 24px } }
.verdict { font-family: var(--display); font-weight: 800; font-size: 54px; letter-spacing: -.04em; line-height: 1; padding: 14px 22px; border-radius: 18px; transform: rotate(-2deg); display: inline-block }
.verdict.fail { background: var(--split); color: #fff } .verdict.pass { background: var(--fine); color: #fff }
.ribbon .lead { font-size: 18px; color: var(--muted); margin-top: 8px; max-width: 60ch }
.pkgcard { background: var(--panel); border-radius: 22px; box-shadow: var(--glow); padding: 20px 22px; display: grid; gap: 12px; min-width: 0; border-left: 8px solid var(--split) }
.pkgcard .top { display: flex; flex-wrap: wrap; gap: 8px 14px; align-items: baseline } .pkgcard .name { font-family: var(--mono); font-weight: 600; font-size: 15px; word-break: break-all }
.finding { display: grid; grid-template-columns: 1fr; gap: 6px; padding: 12px 14px; border-radius: 14px; background: var(--soft) }
.finding .h { display: flex; flex-wrap: wrap; gap: 6px 12px; align-items: baseline } .finding .m { font-family: var(--display); font-weight: 700; font-size: 16px } .finding .d { font-family: var(--mono); font-size: 13px; color: var(--muted) }
.finding .why { font-size: 14px } .finding .open { display: inline-flex; align-items: center; gap: 6px; font-family: var(--mono); font-size: 13px; color: var(--accent); font-weight: 600; width: max-content; max-width: 100%; padding: 4px 10px; border-radius: 999px; background: var(--accent-soft) }
.finding .ov { display: grid; grid-template-columns: 1fr 150px; gap: 10px; align-items: center; font-size: 13px; color: var(--muted) } @media (max-width: 500px) { .finding .ov { grid-template-columns: 1fr } }
.list { display: grid; gap: 14px; margin-top: 16px }
.warncard { background: var(--panel); border-radius: 18px; padding: 14px 18px; display: grid; gap: 6px; border-left: 8px solid var(--watch); box-shadow: var(--glow); min-width: 0 } .warncard .m { font-family: var(--display); font-weight: 700 } .warncard .who { font-family: var(--mono); font-size: 12.5px; color: var(--muted); word-break: break-all }
.pill { display: inline-block; font-family: var(--display); font-weight: 700; font-size: 12px; letter-spacing: .04em; padding: 3px 10px; border-radius: 999px } .pill.fail { background: var(--split); color: #fff } .pill.warn { background: var(--watch); color: #fff } .pill.ok { background: var(--fine); color: #fff }
details { margin-top: 18px; background: var(--panel); border-radius: 18px; padding: 12px 18px; box-shadow: var(--glow) } summary { cursor: pointer; font-weight: 600 } details p { margin-top: 8px; font-size: 14px; color: var(--muted) }
.widgets { display: grid; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap: 14px; margin-top: 14px }
.w { background: var(--panel); border-radius: 16px; padding: 14px 16px; display: grid; gap: 8px; align-content: start; min-width: 0; box-shadow: var(--glow) }
.w h4 { font-family: var(--display); font-size: 15px; margin: 0; display: flex; justify-content: space-between; gap: 8px; align-items: baseline } .w h4 span { font-size: 12px; color: var(--muted); font-weight: 500; font-family: var(--sans); text-align: right }
.w .big { font-family: var(--display); font-size: 28px; font-weight: 800; line-height: 1; letter-spacing: -.02em } .w .big small { font-size: 13px; color: var(--muted); font-weight: 500; font-family: var(--sans); letter-spacing: 0; margin-left: 6px }
.w p { font-size: 13.5px; line-height: 1.45 } .w .fine-t { color: var(--fine) } .w .watch-t { color: var(--watch) } .w .split-t { color: var(--split) }
.track { position: relative; display: grid; grid-template-columns: 1fr 2fr 3fr; gap: 3px; height: 10px; margin-top: 10px } .track i { border-radius: 999px; background: var(--soft); opacity: .9 } .track i.fine { background: var(--fine-soft) } .track i.watch { background: var(--watch-soft) } .track i.split { background: var(--split-soft) }
.track i.on.fine { background: var(--fine) } .track i.on.watch { background: var(--watch) } .track i.on.split { background: var(--split) }
.mk { position: absolute; top: -5px; width: 20px; height: 20px; border-radius: 50%; background: var(--ink); border: 3px solid var(--panel); transform: translateX(-50%); box-shadow: 0 2px 6px rgba(0,0,0,.3) }
.tracklbl { display: grid; grid-template-columns: 1fr 2fr 3fr; gap: 3px; font-size: 11px; color: var(--muted); margin-top: 2px } .tracklbl span:last-child { text-align: right }
.share { display: flex; height: 10px; border-radius: 999px; overflow: hidden; margin-top: 4px } .share i { display: block; height: 100% } .share .spec { background: var(--accent) } .share .vol { background: var(--watch) } .share .rest { background: var(--soft) }
.sharelbl { display: flex; flex-wrap: wrap; gap: 4px 14px; font-size: 12px; color: var(--muted) } .sharelbl i { display: inline-block; width: 9px; height: 9px; border-radius: 2px; margin-right: 5px }
.waffle { display: grid; grid-template-columns: repeat(25, 1fr); gap: 2px; margin-top: 4px } .waffle i { aspect-ratio: 1; border-radius: 2px; background: var(--soft) } .waffle i.on { background: var(--split) } .waffle i.table { background: var(--watch) }
.chunk { font-family: var(--mono); font-size: 12px; color: var(--muted); line-height: 1.5 } .chunk b { color: var(--accent); font-weight: 600 }
.scale { position: relative; height: 10px; border-radius: 999px; margin-top: 10px; background: linear-gradient(90deg, var(--fine) 0 34%, var(--watch) 34% 67%, var(--split) 67% 100%); opacity: .85 }
.scalelbl { display: grid; grid-template-columns: 1fr 1fr 1fr; font-size: 11px; color: var(--muted); margin-top: 2px } .scalelbl span:nth-child(2) { text-align: center } .scalelbl span:last-child { text-align: right }
.fnlist { display: grid; gap: 6px; font-size: 12.5px; margin-top: 4px } .fnlist .f { display: grid; grid-template-columns: 1fr auto; gap: 2px 10px; font-family: var(--mono) } .fnlist .f .where { color: var(--muted); font-size: 11.5px } .fnlist .f .sc { font-weight: 600 } .fnlist .f .m { grid-column: 1 / -1; height: 5px; border-radius: 999px; background: var(--soft); overflow: hidden } .fnlist .f .m i { display: block; height: 100% }
.glossary { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 12px; margin-top: 16px }
.term { background: var(--panel); border-radius: 16px; padding: 14px 16px; box-shadow: var(--glow); font-size: 14px } .term b { font-family: var(--display); font-size: 15px; display: block; margin-bottom: 4px }
.note { font-size: 14px; color: var(--muted); margin-top: 8px; max-width: 70ch }
tr[hidden], .tip[hidden] { display: none }
.b-soft { background: var(--soft) } .sharelbl .spec { background: var(--accent) } .sharelbl .vol { background: var(--watch) }
{{end}}
